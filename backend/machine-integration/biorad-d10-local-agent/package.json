{
  "name": "biorad-d10-local-agent",
  "version": "1.0.0",
  "description": "Bio-Rad D-10 Hemoglobin Analyzer LIS Integration",
  "main": "app.js",
  "bin": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "npx pkg . --targets node18-win-x64 --output dist/biorad-d10-agent.exe"
  },
  "pkg": {
    "assets": [
      "node_modules/@serialport/bindings-cpp/**/*.node",
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*"
    ]
  },
  "dependencies": {
    "axios": "^1.6.2",
    "mysql2": "^3.6.5",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}