# Abbott Architect i1000SR Local Agent Configuration

# TCP Server
TCP_PORT=5300
TCP_HOST=0.0.0.0

# Database - MySQL (Local lab database for offline queue)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=lab_agent_db

# Backend VPS (Central server for syncing results)
VPS_TAILSCALE_URL=http://127.0.0.1:3351

# Retry Configuration
RETRY_INTERVAL_MS=30000
RETRY_BATCH_SIZE=50
RETRY_TIMEOUT_MS=5000

# Machine Identification
MACHINE_NAME=Abbott Architect i1000SR
