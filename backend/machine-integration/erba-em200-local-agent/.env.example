# Erba EM 200 Local Agent Configuration
# Copy this file to .env and update with your environment values

# ============================================
# TCP SERVER CONFIGURATION
# ============================================
TCP_PORT=5200

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Local MySQL database where pending results are queued before VPS sync
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=lab_agent_db

# ============================================
# VPS SYNCHRONIZATION CONFIGURATION
# ============================================
# Tailscale/VPN URL for backend synchronization
# Format: http://ip:port or http://hostname:port
VPS_TAILSCALE_URL=http://192.168.0.119:5000

# ============================================
# RETRY CONFIGURATION
# ============================================
# Interval in milliseconds for offline retry worker (default: 30000ms = 30s)
RETRY_INTERVAL_MS=30000

# Maximum batch size for retry operations
RETRY_BATCH_SIZE=50

# Request timeout for VPS calls in milliseconds
RETRY_TIMEOUT_MS=5000
