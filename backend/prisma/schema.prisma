generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER & AUTHENTICATION MODULE
// ============================================

model Admin {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  email          String          @unique
  password       String
  adminName      String?
  role           String          @default("ADMIN")
  organizationId String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passwordResets PasswordReset[]

  @@index([organizationId])
  @@map("admins")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  adminId   Int
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "password_resets_adminId_fkey")
  @@map("password_resets")
}

model User {
  id                   Int                    @id @default(autoincrement())
  name                 String
  username             String                 @unique
  role                 String
  mobile               String?
  gender               String?
  email                String?
  address              String?                @db.Text
  password             String
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organizationId       String?
  moduleAllocation     ModuleAllocation?
  user_password_resets user_password_resets[]
  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "users_organizationId_fkey")
  @@map("users")
}

model user_password_resets {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_password_resets_userId_fkey")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Organization {
  id                     String             @id
  name                   String             @unique
  code                   String?
  location               String?
  address                String?            @db.Text
  mobile                 String?
  email                  String?
  date                   DateTime?
  discount               Float?             @default(0)    // ✅ NEW: Organization discount field
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  sendReportsViaMail     Boolean            @default(false)
  sendReportsViaWhatsApp Boolean            @default(false)

  // Relations
  admins                 Admin[]
  users                  User[]
  moduleAllocations      ModuleAllocation[]
  patientTest            PatientTest[]
  testcharge             TestCharge[]
  organizationStocks     OrganizationStock[]
  stockTransactions      StockTransaction[]
  labToOrgTransfers      LabToOrgTransfer[]

  @@map("organizations")
}

model ModuleAllocation {
  id             Int           @id @default(autoincrement())
  userId         Int?          @unique
  organizationId String?       @unique
  modules        String?       @db.LongText
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "module_allocation_userId_fkey")
  @@index([organizationId], map: "module_allocation_organizationId_fkey")
  @@map("module_allocations")
}

// ============================================
// PATIENT & HOME VISIT MODULE
// ============================================

model Patient {
  patientId         String              @id
  title             String?
  firstName         String?
  lastName          String?
  dob               DateTime?
  ageYears          Int?     @db.Int       // Renamed from 'age' - stores years component
  ageMonths         Int?     @default(0)   // Months component (0-11)
  ageDays           Int?     @default(0)   // Days component (0-30)
  gender            String?
  mobile            String?
  email             String?
  createdBy         String?
  createdAtLocation String?
  address           String?             @db.Text
  location          String?

  // Authentication & Registration
  password          String?       // Hashed password for direct patient login
  isEmailVerified   Boolean       @default(false)
  isActive          Boolean       @default(true)
  registrationType  String        @default("direct") // "self", "organization", "direct"
  organizationId    String?       // If registered via organization

  // Relations
  tests             PatientTest[]
  auth              PatientAuth?
  homeVisits        HomeVisitTracking[]
  bills              VisitBill[]         // NEW: Billing relation

  createdAt         DateTime?     @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([mobile])
  @@index([email])
  @@index([firstName, lastName], map: "patients_name_idx")
  @@index([createdAt])
  @@index([location])
  @@index([isEmailVerified])
  @@map("patients")
}

model PatientAuth {
  id        String  @id @default(cuid())
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  // Credentials
  email        String @unique
  passwordHash String

  // Verification
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  isEmailVerified         Boolean   @default(false)

  // Password reset
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  // Login tracking
  lastLoginAt   DateTime?
  lastLoginIp   String?
  loginAttempts Int       @default(0)
  isLocked      Boolean   @default(false)
  lockedUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isEmailVerified])
  @@map("patient_auth")
}

model Runner {
  id               String @id @default(cuid())
  name             String
  aadharCard       String @unique
  phone            String @unique
  email            String @unique
  address          String
  assignedLocation String // Location where runner operates

  homeVisits HomeVisitTracking[]
  locations  RunnerLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("runners")
}

model HomeVisitTracking {
  id            String      @id @default(cuid())
  patientTestId Int         @unique // Link to existing PatientTest - one-to-one
  patientTest   PatientTest @relation(fields: [patientTestId], references: [id], onDelete: Cascade)

  patientId String // For quick lookup
  patient   Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id])

  visitDate      DateTime
  visitTime      String // "09:30"
  patientAddress String   @db.Text
  status         String   @default("Scheduled") // Scheduled, RunnerArrived, SampleReceived, Completed

  locations RunnerLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientTestId])
  @@index([patientId])
  @@index([runnerId])
  @@index([status])
  @@map("home_visit_tracking")
}

model RunnerLocation {
  id                  String            @id @default(cuid())
  homeVisitTrackingId String
  homeVisit           HomeVisitTracking @relation(fields: [homeVisitTrackingId], references: [id], onDelete: Cascade)

  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id])

  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime @default(now())

  @@index([homeVisitTrackingId])
  @@index([runnerId])
  @@index([timestamp])
  @@map("runner_locations")
}

model PatientTest {
  id                Int                 @id @default(autoincrement())
  patientId         String
  visitId           String
  testId            Int
  packageId         Int?
  departmentId      Int
  usedMachineId     Int?                // Machine that performed this test
  sample            String
  charge            Decimal             @db.Decimal(10, 2)
  status            String              @default("Registered")  // Registered, Completed, Cancelled
  reportMode        String?
  referralDoctor    String?
  visitDate         DateTime?
  visitTime         String?
  sampleBarcodeNo   String?
  patient_history   String?             @db.Text
  
  // ===== MEDICAL FIELDS (No billing here anymore) =====
  paymentMode       String?
  businessType      String?
  sampleReceived    DateTime?
  sampleTaken       DateTime?
  resultDate        DateTime?
  isExcluded        Boolean             @default(false)
  attachmentPath    String?
  organizationId    String?
  lastUpdatedBy     String?
  lastStatusUpdateAt DateTime?
  barcode_status    String              @default("Unprinted")
  comments          String?             @db.Text
  outsourcedTo      String?
  
  // ===== BILLING SESSION REFERENCE =====
  billingSessionId  Int?
  billingSession    BillingSession?     @relation(fields: [billingSessionId], references: [id], onDelete: SetNull)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  homeVisitTracking HomeVisitTracking?
  outsourcingReport OutsourcingReport?
  department        Department          @relation(fields: [departmentId], references: [id])
  organization      Organization?       @relation(fields: [organizationId], references: [id])
  package           Package?            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  patient           Patient             @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  test              Test                @relation(fields: [testId], references: [id])
  usedMachine       Machine?            @relation(fields: [usedMachineId], references: [id], onDelete: SetNull)
  testResults       TestResult[]
  statusHistory     TestStatusHistory[]

  @@index([departmentId], map: "patient_tests_departmentId_fkey")
  @@index([testId], map: "patient_tests_testId_fkey")
  @@index([organizationId], map: "patient_tests_organizationId_fkey")
  @@index([usedMachineId], map: "patient_tests_usedMachineId_fkey")
  @@index([status])
  @@index([barcode_status])
  @@index([visitDate])
  @@index([visitId])
  @@index([patientId, visitId])
  @@index([billingSessionId])
  @@index([patientId], map: "patient_tests_patientId_fkey")
  @@index([packageId], map: "patient_tests_packageId_fkey")
  @@map("patient_tests")
}

model TestStatusHistory {
  id             Int         @id @default(autoincrement())
  patientTestId  Int
  previousStatus String
  newStatus      String
  changedBy      String?
  changedAt      DateTime    @default(now())
  triggerType    String
  remarks        String?     @db.Text
  patientTest    PatientTest @relation(fields: [patientTestId], references: [id], onDelete: Cascade)

  @@index([patientTestId])
  @@index([changedAt])
  @@map("test_status_history")
}
// ============================================
// LABORATORY & TEST MANAGEMENT MODULE
// ============================================

model Department {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  code         String?
  group        String?
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packages     Package[]
  patientTests PatientTest[]
  tests        Test[]

  @@map("departments")
}

model Test {
  id                     Int                 @id @default(autoincrement())
  name                   String
  shortName              String?
  testCode               String?             @unique
  departmentId           Int
  testParameterId        Int?
  testCategoryId         Int?
  sampleTypeId           Int?
  group                  String?
  reportHeader           String?
  preparationTime        String?
  preparationType        String?
  instructionPreparation String?             @db.Text
  instructionPatient     String?             @db.Text
  interpretationLabel    String?
  interpretation         String?             @db.Text
  outsourceLab           String?
  attachFile             Boolean             @default(false)
  imageSize              String?            @default("800|600")
  profileTest            Boolean             @default(false)
  isHeader               Boolean            @default(true)
  showTestName           Boolean            @default(true)
  isNABL                 Boolean            @default(false)
  lineHeight             Float?             @default(1.4)
  isActive               Boolean            @default(true)
  isDeleted              Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  linkedTestIds          String?            @db.Text
  isOutsourced           Boolean            @default(false)

  testparameters         testparameters[]
  doctorTestCharges      DoctorTestCharge[]
  packageTests           PackageTest[]
  patientTests           PatientTest[]
  categories             TestCategory[]
  charges                TestCharge[]
  ownedParameters        TestParameter[]    @relation("ParameterOwner")
  templates              TestTemplate[]
  testMachines           TestMachine[]
  department             Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  testCategory           TestCategory?       @relation("PrimaryTestCategory", fields: [testCategoryId], references: [id])
  testParameter          TestParameter?      @relation("PrimaryTestParameter", fields: [testParameterId], references: [id])
  sample_type            sample_type?        @relation(fields: [sampleTypeId], references: [id])
  outsourcingLabTests    OutsourcingLabTest[] @relation("OutsourcingTests")


  @@unique([name, departmentId])
  @@index([departmentId], map: "tests_departmentId_fkey")
  @@index([testCategoryId], map: "tests_testCategoryId_fkey")
  @@index([testParameterId], map: "tests_testParameterId_fkey")
  @@index([isActive])
  @@index([isOutsourced])
  @@index([name])
  @@index([sampleTypeId], map: "tests_sampleTypeId_fkey")
  @@map("tests")
}

model Package {
  id           Int           @id @default(autoincrement())
  name         String
  code         String?
  departmentId Int?
  b2cCharge    Float         @default(0)
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packageTests PackageTest[]
  patientTests PatientTest[]
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([departmentId], map: "packages_departmentId_fkey")
  @@map("packages")
}

model PackageTest {
  id        Int      @id @default(autoincrement())
  packageId Int
  testId    Int
  createdAt DateTime @default(now())
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([packageId, testId])
  @@index([testId], map: "package_tests_testId_fkey")
  @@map("package_tests")
}

model TestCharge {
  id              Int           @id @default(autoincrement())
  testId          Int
  organizationId  String?
  b2cCharge       Float
  b2bCharge       Float
  discountPercent Float?        @default(0)
  specialPrice    Float?
  effectiveFrom   DateTime      @default(now())
  effectiveTo     DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  test            Test          @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, organizationId])
  @@index([organizationId], map: "test_charges_organizationId_fkey")
  @@index([testId], map: "test_charges_testId_fkey")
  @@map("test_charges")
}

model DoctorTestCharge {
  id            Int       @id @default(autoincrement())
  testId        Int
  doctorId      Int
  discountR     Float?    @default(0)
  discountS     Float?    @default(0)
  isCustomized  Boolean   @default(false)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  test          Test      @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, doctorId])
  @@index([doctorId], map: "doctor_test_charges_doctorId_fkey")
  @@map("doctor_test_charges")
}

model Doctor {
  id                     Int                @id @default(autoincrement())
  name                   String
  degree                 String?
  mobile                 String?
  specialty              String?
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  address                String?            @db.Text
  email                  String?
  type                   String             @default("Doctor")
  sendReportsViaMail     Boolean            @default(false)
  sendReportsViaWhatsApp Boolean            @default(false)
  mergedTo               DoctorMerge[]      @relation("SourceDoctor")
  mergedFrom             DoctorMerge[]      @relation("TargetDoctor")
  testCharges            DoctorTestCharge[]

  @@map("doctors")
}

model DoctorMerge {
  id               Int      @id @default(autoincrement())
  sourceDoctorId   Int
  targetDoctorId   Int
  sourceDoctorName String
  targetDoctorName String
  recordsUpdated   Int      @default(0)
  chargesUpdated   Int      @default(0)
  mergedAt         DateTime @default(now())
  mergedBy         String?
  sourceDoctor     Doctor   @relation("SourceDoctor", fields: [sourceDoctorId], references: [id], onDelete: Cascade)
  targetDoctor     Doctor   @relation("TargetDoctor", fields: [targetDoctorId], references: [id], onDelete: Cascade)

  @@index([sourceDoctorId])
  @@index([targetDoctorId])
  @@index([mergedAt])
  @@map("doctor_merges")
}

model TestParameter {
  id                 Int              @id @default(autoincrement())
  testId             Int?
  unitId             Int?
  parameterName      String
  machineCode        String?
  multiplyBy         String?
  decimal            Int?             @default(2)
  parameterSortOrder Int?
  isDescriptive      Boolean          @default(false)
  lowPanic           Float?
  highPanic          Float?
  isNABL             Boolean          @default(false)
  parameterCode      String?          @unique
  testMethod         String?
  hasFormula         Boolean          @default(false)
  formula            String?          @db.Text
  type               String           @default("Numeric")
  isMandatory        Boolean          @default(false)
  rangeType          String           @default("BySex")
  displayRangeText   String?          @db.Text
  rangeText          String?          @db.Text
  textContent        String?          @db.Text
  isMultipleOptions  Boolean          @default(false)
  maleLowValue       String?
  maleHighValue      String?
  maleDefaultValue   String?
  maleActive         Boolean          @default(true)
  femaleLowValue     String?
  femaleHighValue    String?
  femaleDefaultValue String?
  femaleActive       Boolean          @default(false)
  childLowValue      String?
  childHighValue     String?
  childDefaultValue  String?
  childActive        Boolean          @default(false)
  ageRanges          String?          @db.Text
  rangeValues        String?          @db.Text
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  testparameters     testparameters[]
  testCategories     TestCategory[]
  testOwner          Test?            @relation("ParameterOwner", fields: [testId], references: [id], onDelete: Cascade)
  unit               Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  testResults        TestResult[]
  primaryTests       Test[]           @relation("PrimaryTestParameter")

  @@index([testId], map: "test_parameters_testId_fkey")
  @@index([unitId], map: "test_parameters_unitId_fkey")
  @@index([parameterCode])
  @@map("test_parameters")
}

model TestCategory {
  id              Int            @id @default(autoincrement())
  testId          Int
  testParameterId Int
  categoryId      String?
  categoryName    String?
  isCategory      Boolean        @default(false)
  testMethod      String?
  sortOrder       Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  testParameter   TestParameter  @relation(fields: [testParameterId], references: [id], onDelete: Cascade)
  testResults     TestResult[]
  templates       TestTemplate[]
  primaryTests    Test[]         @relation("PrimaryTestCategory")

  @@index([testId], map: "test_categories_testId_fkey")
  @@index([testParameterId], map: "test_categories_testParameterId_fkey")
  @@map("test_categories")
}

model Unit {
  id         Int             @id @default(autoincrement())
  symbol     String          @unique
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  parameters TestParameter[]

  @@map("units")
}

model TestTemplate {
  id             Int           @id @default(autoincrement())
  testId         Int
  testCategoryId Int?
  templateName   String        @db.VarChar(255)
  parameters     String?       @db.Text
  isActive       Boolean       @default(true)
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  testCategory   TestCategory? @relation(fields: [testCategoryId], references: [id])
  test           Test          @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, templateName])
  @@index([testCategoryId], map: "test_templates_testCategoryId_fkey")
  @@index([testId], map: "test_templates_testId_fkey")
  @@map("test_templates")
}

model testparameters {
  A               Int
  B               Int
  tests           Test          @relation(fields: [A], references: [id], onDelete: Cascade, map: "_TestParameters_A_fkey")
  test_parameters TestParameter @relation(fields: [B], references: [id], onDelete: Cascade, map: "_TestParameters_B_fkey")

  @@unique([A, B], map: "_TestParameters_AB_unique")
  @@index([B], map: "_TestParameters_B_index")
  @@map("_testparameters")
}

model sample_type {
  id           Int    @id @default(autoincrement())
  Sample_Type  String @unique(map: "Sample_Type_Sample_Type_key")
  Sample_Color String
  test         Test[]

  @@map("sample_types")
}

// ============================================
// PATIENT TEST EXECUTION & RESULTS
// ============================================

model TestResult {
  id              Int           @id @default(autoincrement())
  patientTestId   Int
  testParameterId Int
  testCategoryId  Int?
  numericValue    String?       // Store numeric value with optional symbols: "<7.5", ">140", "7.5", etc.
  textValue       String?
  selectedOption  String?
  isHighlighted   Boolean       @default(false) // Checkbox to highlight/bold this value in reports
  enteredBy       String?
  verifiedBy      String?
  enteredAt       DateTime      @default(now())
  verifiedAt      DateTime?
  patientTest     PatientTest   @relation(fields: [patientTestId], references: [id], onDelete: Cascade)
  testCategory    TestCategory? @relation(fields: [testCategoryId], references: [id])
  testParameter   TestParameter @relation(fields: [testParameterId], references: [id])

  @@unique([patientTestId, testParameterId])
  @@index([patientTestId])
  @@index([testParameterId])
  @@index([testCategoryId], map: "test_results_testCategoryId_fkey")
  @@map("test_results")
}

model Machine {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  testMachines TestMachine[]
  patientTests PatientTest[]

  @@map("machines")
}

model TestMachine {
  id        Int       @id @default(autoincrement())
  testId    Int
  machineId Int
  createdAt DateTime  @default(now())
  
  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  machine   Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([testId, machineId])
  @@index([testId])
  @@index([machineId])
  @@map("test_machines")
}


// ============================================
// BILLING & INVOICE MODULE (NORMALIZED)
// ============================================

// Enums for Billing
enum BillStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
  OVERPAID
}

enum BillingSessionType {
  REGISTRATION
  ADD_TEST
  PAYMENT
  DISCOUNT
  REFUND
  CANCEL_TEST
  EDIT_TEST
  SETTLEMENT
}

enum PaymentMode {
  CASH
  CARD
  UPI
  CHEQUE
  BANK_TRANSFER
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FLAT
  WRITEOFF
}

enum TransactionType {
  INITIAL_BILL
  ADD_TEST
  CANCEL_TEST
  DISCOUNT
  PAYMENT
  REFUND
  WRITE_OFF
  EDIT_CHARGE
}

// Master Bill Record - One per Visit
model VisitBill {
  id                Int             @id @default(autoincrement())
  visitId           String          @unique
  patientId         String
  
  // Financial Summary
  grossAmount       Decimal         @db.Decimal(12, 2)  // Sum of all test charges
  totalDiscount     Decimal         @db.Decimal(12, 2)  // Total discount applied (in rupees)
  totalDiscountPercent Float        @default(0)        // Average discount percentage
  totalPaid         Decimal         @db.Decimal(12, 2)  // Total payment received
  totalRefund       Decimal         @db.Decimal(12, 2)  // Total refund given
  balanceAmount     Decimal         @db.Decimal(12, 2)  // Outstanding balance
  
  // Status
  status            BillStatus      @default(PENDING)
  
  // Timestamps
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  // Relations
  patient           Patient         @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  billingSessions   BillingSession[]
  discounts         BillDiscount[]
  payments          Payment[]
  refunds           Refund[]
  
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("visit_bills")
}

// Billing Session - Groups related activities
model BillingSession {
  id                Int                 @id @default(autoincrement())
  visitId           String
  visitBill         VisitBill           @relation(fields: [visitId], references: [visitId], onDelete: Cascade)
  
  sequence          Int                 // Order of sessions (1, 2, 3, etc.)
  sessionType       BillingSessionType
  remarks           String?             @db.Text
  createdBy         Int?
  createdAt         DateTime            @default(now())
  
  // Relations
  patientTests      PatientTest[]
  discounts         BillDiscount[]
  payments          Payment[]
  refunds           Refund[]
  
  @@index([visitId])
  @@index([sessionType])
  @@index([createdAt])
  @@unique([visitId, sequence])
  @@map("billing_sessions")
}

// Discount Records - Never overwritten
model BillDiscount {
  id                Int             @id @default(autoincrement())
  visitId           String
  visitBill         VisitBill       @relation(fields: [visitId], references: [visitId], onDelete: Cascade)
  
  billingSessionId  Int
  billingSession    BillingSession  @relation(fields: [billingSessionId], references: [id], onDelete: Cascade)
  
  // Discount Details
  discountType      DiscountType    // PERCENTAGE or FLAT
  discountValue     Decimal         @db.Decimal(10, 2)  // Either % value or flat amount
  discountAmount    Decimal         @db.Decimal(12, 2)  // Actual discount in rupees
  appliedOnAmount   Decimal         @db.Decimal(12, 2)  // Amount on which discount was applied
  
  remarks           String?         @db.Text
  createdBy         Int?
  createdAt         DateTime        @default(now())
  
  @@index([visitId])
  @@index([billingSessionId])
  @@map("bill_discounts")
}

// Payment Records - COMBINED (Payment + PaymentTransaction + BillTransaction for payments)
// Never overwritten, contains full audit trail
model Payment {
  id                Int             @id @default(autoincrement())
  visitId           String
  visitBill         VisitBill       @relation(fields: [visitId], references: [visitId], onDelete: Cascade)
  
  billingSessionId  Int
  billingSession    BillingSession  @relation(fields: [billingSessionId], references: [id], onDelete: Cascade)
  
  // Payment Details
  amount            Decimal         @db.Decimal(12, 2)      // Amount received
  paymentMode       PaymentMode                              // CASH, CARD, UPI, etc.
  
  // Transaction Details (previously in PaymentTransaction)
  transactionId     String?                                  // Bank/gateway transaction ID
  transactionStatus String          @default("SUCCESS")     // SUCCESS, FAILED, PENDING
  
  // Audit Trail (previously in BillTransaction)
  remarks           String?         @db.Text
  receivedBy        Int?                                     // User who received payment
  paymentDate       DateTime        @default(now())         // When payment was received
  
  // Reconciliation
  isReconciled      Boolean         @default(false)
  reconciledBy      Int?
  reconciledAt      DateTime?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  
  @@index([visitId])
  @@index([billingSessionId])
  @@index([paymentDate])
  @@index([transactionStatus])
  @@map("payments")
}

// Refund Records - Never overwritten
model Refund {
  id                Int             @id @default(autoincrement())
  visitId           String
  visitBill         VisitBill       @relation(fields: [visitId], references: [visitId], onDelete: Cascade)
  
  billingSessionId  Int
  billingSession    BillingSession  @relation(fields: [billingSessionId], references: [id], onDelete: Cascade)
  
  // Refund Details
  amount            Decimal         @db.Decimal(12, 2)
  reason            String?         @db.Text
  refundedBy        Int?
  createdAt         DateTime        @default(now())
  
  @@index([visitId])
  @@index([billingSessionId])
  @@map("refunds")
}

model Signature {
  id             Int      @id @default(autoincrement())
  doctorName     String?
  signatureText  String?  @db.Text
  signatureImage String?  @db.Text
  imageSize      String?  @default("800|600")
  width          Int?     @default(150)
  height         Int?     @default(80)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("signatures")
}

// ============================================
// INVENTORY MODULE
// ============================================

model OutsourcingLab {
  id        Int                  @id @default(autoincrement())
  labName   String               @unique
  code      String               @unique
  mobile    String?
  address   String?              @db.Text
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tests     OutsourcingLabTest[]
  reports   OutsourcingReport[]

  @@map("outsourcing_labs")
}

model OutsourcingLabTest {
  id               Int            @id @default(autoincrement())
  outsourcingLabId Int
  testId           Int
  charge           Float
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  outsourcingLab   OutsourcingLab @relation(fields: [outsourcingLabId], references: [id], onDelete: Cascade)
  test             Test           @relation("OutsourcingTests", fields: [testId], references: [id], onDelete: Cascade)

  @@unique([outsourcingLabId, testId])
  @@index([outsourcingLabId])
  @@index([testId])
  @@map("outsourcing_lab_tests")
}

model OutsourcingReport {
  id               Int            @id @default(autoincrement())
  patientTestId    Int            @unique
  outsourcingLabId Int
  reportFileUrl    String         @db.Text
  letterheadUrl    String?        @db.Text
  extractedData    String?        @db.LongText
  pdfMetadata      String?        @db.Text
  importedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  outsourcingLab   OutsourcingLab @relation(fields: [outsourcingLabId], references: [id], onDelete: Cascade)
  patientTest      PatientTest    @relation(fields: [patientTestId], references: [id], onDelete: Cascade)

  @@index([patientTestId])
  @@index([outsourcingLabId])
  @@map("outsourcing_reports")
}
model HSNCode {
  id        Int      @id @default(autoincrement())
  hsnCode   String   @unique
  category  String
  gstRate   Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]

  @@map("hsn_codes")
}

model InventoryItem {
  id        Int      @id @default(autoincrement())
  itemName  String   @unique
  itemCode  String   @unique
  hsnCodeId Int
  unit      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hsnCode         HSNCode                @relation(fields: [hsnCodeId], references: [id])
  stockEntryItems StockEntryItem[]
  labStocks       LabStock[]
  orgStocks       OrganizationStock[]
  transactions    StockTransaction[]
  transferItems   LabToOrgTransferItem[]

  @@index([hsnCodeId])
  @@map("inventory_items")
}

model Supplier {
  id           Int      @id @default(autoincrement())
  supplierName String   @unique
  email        String?
  phone        String?   @unique
  address      String?  @db.Text
  city         String?
  state        String?
  pinCode      String?
  gstNumber    String?   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockEntries StockEntry[]

  @@map("suppliers")
}

model StockEntry {
  id               Int      @id @default(autoincrement())
  entryId          String   @unique
  supplierId       Int
  invoiceNo        String
  invoiceDate      DateTime
  igstPercent      Float    @default(0)
  totalBasicAmount Float    @default(0)
  totalCGST        Float    @default(0)
  totalSGST        Float    @default(0)
  totalIGST        Float    @default(0)
  grandTotal       Float    @default(0)
  status           String   @default("Active")
  remarks          String?  @db.Text
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  items    StockEntryItem[]

  @@index([supplierId])
  @@map("stock_entries")
}

model StockEntryItem {
  id           Int      @id @default(autoincrement())
  stockEntryId Int
  itemId       Int
  batchNo      String
  expiryDate   DateTime
  quantity     Int
  pricePerUnit Float
  basicAmount  Float
  cgstPercent  Float
  cgstAmount   Float
  sgstPercent  Float
  sgstAmount   Float
  igstPercent  Float
  igstAmount   Float
  totalAmount  Float
  createdAt    DateTime @default(now())

  stockEntry StockEntry    @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([stockEntryId, itemId, batchNo])
  @@index([stockEntryId])
  @@index([itemId])
  @@map("stock_entry_items")
}

model LabStock {
  id                Int      @id @default(autoincrement())
  itemId            Int
  batchNo           String
  expiryDate        DateTime
  quantityAvailable Int
  lastStockUpdate   DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, batchNo])
  @@index([itemId])
  @@map("lab_stocks")
}

model OrganizationStock {
  id                Int      @id @default(autoincrement())
  organizationId    String
  itemId            Int
  batchNo           String
  expiryDate        DateTime
  quantityAvailable Int
  lastStockUpdate   DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item         InventoryItem @relation(fields: [itemId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, itemId, batchNo])
  @@index([organizationId])
  @@index([itemId])
  @@map("organization_stocks")
}

model StockTransaction {
  id              Int      @id @default(autoincrement())
  transactionId   String   @unique
  itemId          Int
  organizationId  String?
  batchNo         String
  quantity        Int
  transactionType String?
  reason          String?  @db.Text
  approvedBy      String?
  createdBy       String?
  createdAt       DateTime @default(now())

  item         InventoryItem @relation(fields: [itemId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([itemId])
  @@index([organizationId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("stock_transactions")
}

model LabToOrgTransfer {
  id             Int      @id @default(autoincrement())
  transferId     String   @unique
  organizationId String?
  transferDate   DateTime
  status         String   @default("Pending")
  remarks        String?  @db.Text
  createdBy      String?
  approvedBy     String?
  receivedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items        LabToOrgTransferItem[]
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("lab_to_org_transfers")
}

model LabToOrgTransferItem {
  id         Int      @id @default(autoincrement())
  transferId Int
  itemId     Int
  batchNo    String
  quantity   Int
  expiryDate DateTime
  createdAt  DateTime @default(now())

  transfer LabToOrgTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     InventoryItem    @relation(fields: [itemId], references: [id])

  @@unique([transferId, itemId, batchNo])
  @@index([transferId])
  @@index([itemId])
  @@map("lab_to_org_transfer_items")
}


// ============================================
// REPORT SETTINGS MODULE
// ============================================

model ReportFieldConfiguration {
  id              Int       @id @default(autoincrement())
  fieldKey        String    @unique
  fieldLabel      String
  isVisible       Boolean   @default(true)
  isBold          Boolean   @default(false)
  isItalic        Boolean   @default(false)
  isUnderline     Boolean   @default(false)
  displayOrder    Int
  sectionName     String
  customLabel     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sectionName])
  @@index([displayOrder])
  @@map("report_field_configurations")
}

model ReportFormatting {
  id                      Int       @id @default(autoincrement())
  fontFamily              String    @default("Bookman Old Text")
  fontSizeHeader          Float     @default(14)
  fontSizeBody            Float     @default(11)
  fontSizeFooter          Float     @default(9)
  paperSize               String    @default("A4")
  orientation             String    @default("Portrait")
  topMargin               Float     @default(10)
  bottomMargin            Float     @default(10)
  leftMargin              Float     @default(10)
  rightMargin             Float     @default(10)
  lineHeight              Float     @default(1.4)
  showHeader              Boolean   @default(true)
  showFooter              Boolean   @default(true)
  showWatermark           Boolean   @default(false)
  showQRCode              Boolean   @default(true)
  showBarcode             Boolean   @default(true)
  showPrimarySignature    Boolean   @default(true)
  showSecondarySignature  Boolean   @default(false)
  signaturePosition       String    @default("Bottom Right")
  footerText              String?   @db.Text
  watermarkText           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("report_formatting")
}
