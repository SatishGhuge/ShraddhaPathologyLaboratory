generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  email          String          @unique
  password       String
  adminName      String?
  role           String          @default("ADMIN")
  organizationId String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  passwordResets PasswordReset[]
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("admins")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  adminId   Int
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "password_resets_adminId_fkey")
  @@map("password_resets")
}

model Patient {
  patientId         String        @id
  title             String?
  firstName         String?
  lastName          String?
  dob               DateTime?
  age               Int?
  gender            String?
  mobile            String?
  email             String?
  createdBy         String?
  createdAtLocation String?
  address           String?       @db.Text
  location          String?
  
  // Authentication fields
  password          String?       // Hashed password for patient login
  isEmailVerified   Boolean       @default(false)
  isActive          Boolean       @default(true)
  registrationType  String        @default("direct") // "self", "organization", "direct"
  organizationId    String?       // If registered via organization
  
  // Relations
  tests             PatientTest[]
  auth              PatientAuth?
  homeVisits        HomeVisitTracking[]
  
  createdAt         DateTime?     @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([mobile])
  @@index([email])
  @@index([firstName, lastName], map: "patients_name_idx")
  @@index([createdAt])
  @@index([location])
  @@index([isEmailVerified])
  @@map("patients")
}

model PatientAuth {
  id                 String        @id @default(cuid())
  patientId          String        @unique
  patient            Patient       @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  
  // Credentials
  email              String        @unique
  passwordHash       String
  
  // Verification
  emailVerificationToken String?
  emailVerificationExpiry DateTime?
  isEmailVerified    Boolean       @default(false)
  
  // Password reset
  passwordResetToken String?
  passwordResetExpiry DateTime?
  
  // Login tracking
  lastLoginAt        DateTime?
  lastLoginIp        String?
  loginAttempts      Int           @default(0)
  isLocked           Boolean       @default(false)
  lockedUntil        DateTime?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  
  @@index([email])
  @@index([isEmailVerified])
  @@map("patient_auth")
}

model Runner {
  id                String           @id @default(cuid())
  name              String
  aadharCard        String           @unique
  phone             String           @unique
  email             String           @unique
  address           String
  assignedLocation  String           // Location where runner operates
  
  homeVisits        HomeVisitTracking[]
  locations         RunnerLocation[]
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@map("runners")
}

model HomeVisitTracking {
  id                String           @id @default(cuid())
  patientTestId     Int              @unique  // Link to existing PatientTest - one-to-one
  patientTest       PatientTest      @relation(fields: [patientTestId], references: [id], onDelete: Cascade)
  
  patientId         String           // For quick lookup
  patient           Patient          @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  
  runnerId          String
  runner            Runner           @relation(fields: [runnerId], references: [id])
  
  visitDate         DateTime
  visitTime         String           // "09:30"
  patientAddress    String           @db.Text
  status            String           @default("Scheduled") // Scheduled, RunnerArrived, SampleReceived, Completed
  
  locations         RunnerLocation[]
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@index([patientTestId])
  @@index([patientId])
  @@index([runnerId])
  @@index([status])
  @@map("home_visit_tracking")
}

model RunnerLocation {
  id                String           @id @default(cuid())
  homeVisitTrackingId String
  homeVisit         HomeVisitTracking @relation(fields: [homeVisitTrackingId], references: [id], onDelete: Cascade)
  
  runnerId          String
  runner            Runner           @relation(fields: [runnerId], references: [id])
  
  latitude          Float
  longitude         Float
  accuracy          Float?
  timestamp         DateTime         @default(now())
  
  @@index([homeVisitTrackingId])
  @@index([runnerId])
  @@index([timestamp])
  @@map("runner_locations")
}

model PatientTest {
  id                 Int                 @id @default(autoincrement())
  patientId          String
  visitId            String
  testId             Int
  packageId          Int?
  departmentId       Int
  sample             String
  charge             Float
  status             String              @default("Registered")
  reportMode         String?
  referralDoctor     String?
  visitDate          DateTime?
  visitTime          String?
  sampleBarcodeNo    String?
  patient_history    String?             @db.Text
  totalAmount        Float               @default(0)
  discountPercent    Float               @default(0)
  discountAmount     Float               @default(0)
  discountRemark     String?
  paidAmount         Float               @default(0)
  balanceAmount      Float               @default(0)
  paymentMode        String?
  businessType       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sampleReceived     DateTime?
  sampleTaken        DateTime?
  resultDate         DateTime?
  isExcluded         Boolean             @default(false)
  attachmentPath     String?
  organizationId     String?
  lastUpdatedBy      String?
  lastStatusUpdateAt DateTime?
  barcode_status     String              @default("Unprinted")
  comments           String?             @db.Text
  
  // Relations
  department         Department          @relation(fields: [departmentId], references: [id])
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  patient            Patient             @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  test               Test                @relation(fields: [testId], references: [id])
  package            Package?            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  testResults        TestResult[]
  statusHistory      TestStatusHistory[]
  homeVisitTracking  HomeVisitTracking?

  @@index([departmentId], map: "patient_tests_departmentId_fkey")
  @@index([testId], map: "patient_tests_testId_fkey")
  @@index([organizationId], map: "patient_tests_organizationId_fkey")
  @@index([status])
  @@index([barcode_status])
  @@index([visitDate])
  @@index([visitId])
  @@index([patientId, visitId])
  @@index([patientId], map: "patient_tests_patientId_fkey")
  @@map("patient_tests")
}

model TestStatusHistory {
  id             Int         @id @default(autoincrement())
  patientTestId  Int
  previousStatus String
  newStatus      String
  changedBy      String?
  changedAt      DateTime    @default(now())
  triggerType    String
  remarks        String?     @db.Text
  patientTest    PatientTest @relation(fields: [patientTestId], references: [id], onDelete: Cascade)

  @@index([patientTestId])
  @@index([changedAt])
  @@map("test_status_history")
}

model Department {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  code         String?
  group        String?
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packages     Package[]
  patientTests PatientTest[]
  tests        Test[]

  @@map("departments")
}

model Test {
  id                     Int                 @id @default(autoincrement())
  name                   String
  shortName              String?
  testCode               String?             @unique
  departmentId           Int
  testParameterId        Int?
  testCategoryId         Int?
  sampleTypeId           Int?
  machineName            String?
  group                  String?
  reportHeader           String?
  preparationTime        String?
  preparationType        String?
  instructionPreparation String?             @db.Text
  instructionPatient     String?             @db.Text
  interpretationLabel    String?
  interpretation         String?             @db.Text
  outsourceLab           String?
  attachFile             Boolean?             @default(false)
  imageSize              String?             @default("800|600")
  profileTest            Boolean             @default(false)
  isHeader               Boolean             @default(true)
  showTestName           Boolean             @default(true)
  isNABL                 Boolean             @default(false)
  lineHeight             Float?              @default(1.4)
  isActive               Boolean             @default(true)
  isDeleted              Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  linkedTestIds          String?             @db.Text
  testparameters         testparameters[]
  packageTests           PackageTest[]
  patientTests           PatientTest[]
  categories             TestCategory[]
  charges                TestCharge[]
  doctorTestCharges      DoctorTestCharge[]
  ownedParameters        TestParameter[]     @relation("ParameterOwner")
  templates              TestTemplate[]
  department             Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  testCategory           TestCategory?       @relation("PrimaryTestCategory", fields: [testCategoryId], references: [id])
  testParameter          TestParameter?      @relation("PrimaryTestParameter", fields: [testParameterId], references: [id])
  sample_type            sample_type?        @relation(fields: [sampleTypeId], references: [id])

  @@unique([name, departmentId])
  @@index([departmentId], map: "tests_departmentId_fkey")
  @@index([testCategoryId], map: "tests_testCategoryId_fkey")
  @@index([testParameterId], map: "tests_testParameterId_fkey")
  @@index([isActive])
  @@index([name])
  @@map("tests")
}

model Package {
  id           Int           @id @default(autoincrement())
  name         String
  code         String?
  departmentId Int
  b2cCharge    Float         @default(0)
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packageTests PackageTest[]
  patientTests PatientTest[]
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)


  @@index([departmentId], map: "packages_departmentId_fkey")
  @@map("packages")
}

model PackageTest {
  id        Int      @id @default(autoincrement())
  packageId Int
  testId    Int
  createdAt DateTime @default(now())
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([packageId, testId])
  @@index([testId], map: "package_tests_testId_fkey")
  @@map("package_tests")
}

model TestCharge {
  id                 Int                 @id @default(autoincrement())
  testId             Int
  organizationId     String?
  b2cCharge          Float
  b2bCharge          Float
  discountPercent    Float?              @default(0)
  specialPrice       Float?
  effectiveFrom      DateTime            @default(now())
  effectiveTo        DateTime?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  test               Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([testId])
  @@map("test_charges")
}

model DoctorTestCharge {
  id              Int       @id @default(autoincrement())
  testId          Int
  doctorId        Int
  discountR       Float?    @default(0)
  discountS       Float?    @default(0)
  isCustomized    Boolean   @default(false)
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  doctor          Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  test            Test      @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, doctorId])
  @@index([doctorId], map: "doctor_test_charges_doctorId_fkey")
  @@map("doctor_test_charges")
}

model Doctor {
  id                     Int                @id @default(autoincrement())
  name                   String
  degree                 String?
  mobile                 String?
  specialty              String?
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  address                String?            @db.Text
  email                  String?
  type                   String             @default("Doctor")
  sendReportsViaMail     Boolean            @default(false)
  sendReportsViaWhatsApp Boolean            @default(false)
  testCharges            DoctorTestCharge[]
  mergedTo               DoctorMerge[]           @relation("SourceDoctor")
  mergedFrom             DoctorMerge[]           @relation("TargetDoctor")
  @@map("doctors")
}

model DoctorMerge {
  id                Int       @id @default(autoincrement())
  sourceDoctorId    Int
  targetDoctorId    Int
  sourceDoctorName  String
  targetDoctorName  String
  recordsUpdated    Int       @default(0)
  chargesUpdated    Int       @default(0)
  mergedAt          DateTime  @default(now())
  mergedBy          String?
  sourceDoctor      Doctor    @relation("SourceDoctor", fields: [sourceDoctorId], references: [id], onDelete: Cascade)
  targetDoctor      Doctor    @relation("TargetDoctor", fields: [targetDoctorId], references: [id], onDelete: Cascade)

  @@index([sourceDoctorId])
  @@index([targetDoctorId])
  @@index([mergedAt])
  @@map("doctor_merges")
}

model Organization {
  id                 String              @id
  name               String              @unique
  code               String?
  location           String?
  address            String?             @db.Text
  mobile             String?
  email              String?
  date               DateTime?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sendReportsViaMail     Boolean           @default(false)
  sendReportsViaWhatsApp Boolean           @default(false)
  admins             Admin[]
  users              User[]
  moduleAllocations  ModuleAllocation[]
  patientTest        PatientTest[]
  testcharge         TestCharge[]
  @@map("organizations")
}

model TestParameter {
  id                 Int              @id @default(autoincrement())
  testId             Int?
  unitId             Int?
  parameterName      String
  machineCode        String?
  multiplyBy         String?
  decimal            Int?             @default(2)
  parameterSortOrder Int?
  isDescriptive      Boolean          @default(false)
  lowPanic           Float?
  highPanic          Float?
  isNABL             Boolean          @default(false)
  parameterCode      String?          @unique
  testMethod         String?
  hasFormula         Boolean          @default(false)
  formula            String?          @db.Text
  type               String           @default("Numeric")
  isMandatory        Boolean          @default(false)
  rangeType          String           @default("BySex")
  displayRangeText   String?          @db.Text
  rangeText          String?          @db.Text
  textContent        String?          @db.Text
  isMultipleOptions  Boolean          @default(false)
  maleLowValue       Float?
  maleHighValue      Float?
  maleDefaultValue   String?
  maleActive         Boolean          @default(true)
  femaleLowValue     Float?
  femaleHighValue    Float?
  femaleDefaultValue String?
  femaleActive       Boolean          @default(false)
  childLowValue      Float?
  childHighValue     Float?
  childDefaultValue  String?
  childActive        Boolean          @default(false)
  ageRanges          String?          @db.Text
  rangeValues        String?          @db.Text
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  testparameters     testparameters[]
  testCategories     TestCategory[]
  testOwner          Test?            @relation("ParameterOwner", fields: [testId], references: [id], onDelete: Cascade)
  testResults        TestResult[]
  primaryTests       Test[]           @relation("PrimaryTestParameter")
  unit               Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  @@index([testId], map: "test_parameters_testId_fkey")
  @@index([unitId], map: "test_parameters_unitId_fkey")
  @@index([parameterCode])
  @@map("test_parameters")
}

model TestCategory {
  id              Int            @id @default(autoincrement())
  testId          Int
  testParameterId Int
  categoryId      String?
  categoryName    String?
  isCategory      Boolean        @default(false)
  testMethod      String?
  sortOrder       Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  testParameter   TestParameter  @relation(fields: [testParameterId], references: [id], onDelete: Cascade)
  testResults     TestResult[]
  templates       TestTemplate[]
  primaryTests    Test[]         @relation("PrimaryTestCategory")

  @@index([testId], map: "test_categories_testId_fkey")
  @@index([testParameterId], map: "test_categories_testParameterId_fkey")
  @@map("test_categories")
}

model Unit {
  id           Int            @id @default(autoincrement())
  symbol       String         @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  parameters   TestParameter[]

  @@map("units")
}

model TestTemplate {
  id             Int           @id @default(autoincrement())
  testId         Int
  testCategoryId Int?
  templateName   String        @db.VarChar(255)
  parameters     String?       @db.Text
  isActive       Boolean       @default(true)
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  testCategory   TestCategory? @relation(fields: [testCategoryId], references: [id])
  test           Test          @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, templateName])
  @@index([testCategoryId], map: "test_templates_testCategoryId_fkey")
  @@index([testId], map: "test_templates_testId_fkey")
  @@map("test_templates")
}

model TestResult {
  id              Int           @id @default(autoincrement())
  patientTestId   Int
  testParameterId Int
  testCategoryId  Int?
  numericValue    Float?
  textValue       String?
  selectedOption  String?
  lowValue        Float?
  highValue       Float?
  referenceRange  String?
  enteredBy       String?
  verifiedBy      String?
  enteredAt       DateTime      @default(now())
  verifiedAt      DateTime?
  patientTest     PatientTest   @relation(fields: [patientTestId], references: [id], onDelete: Cascade)
  testCategory    TestCategory? @relation(fields: [testCategoryId], references: [id])
  testParameter   TestParameter @relation(fields: [testParameterId], references: [id])

  @@unique([patientTestId, testParameterId])
  @@index([patientTestId])
  @@index([testParameterId])
  @@index([testCategoryId], map: "test_results_testCategoryId_fkey")
  @@index([patientTestId, testParameterId])
  @@map("test_results")
}

model testparameters {
  A               Int
  B               Int
  tests           Test          @relation(fields: [A], references: [id], onDelete: Cascade, map: "_TestParameters_A_fkey")
  test_parameters TestParameter @relation(fields: [B], references: [id], onDelete: Cascade, map: "_TestParameters_B_fkey")

  @@unique([A, B], map: "_TestParameters_AB_unique")
  @@index([B], map: "_TestParameters_B_index")
  @@map("_testparameters")
}

model sample_type {
  id           Int    @id @default(autoincrement())
  Sample_Type  String @unique(map: "Sample_Type_Sample_Type_key")
  Sample_Color String
  test         Test[]
  @@map("sample_types")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id                   Int                    @id @default(autoincrement())
  name                 String
  username             String                 @unique
  role                 String
  mobile               String?
  gender               String?
  email                String?
  address              String?                @db.Text
  password             String
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organizationId       String?
  moduleAllocation     ModuleAllocation?
  user_password_resets user_password_resets[]
  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "users_organizationId_fkey")
  @@map("users")
}

model PaymentTransaction {
  id            Int      @id @default(autoincrement())
  visitId       String
  patientId     String
  paymentMode   String
  paymentAmount Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visitId])
  @@index([patientId])
  @@index([paymentMode])
  @@map("payment_transactions")
}

model Signature {
  id             Int       @id @default(autoincrement())
  doctorName     String?
  signatureText  String?   @db.Text
  signatureImage String?   @db.Text
  imageSize      String?   @default("800|600")
  width          Int?      @default(150)
  height         Int?      @default(80)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("signatures")
}

model ModuleAllocation {
  id             Int           @id @default(autoincrement())
  userId         Int?          @unique
  organizationId String?       @unique
  modules        String?       @db.LongText
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "module_allocation_userId_fkey")
  @@index([organizationId], map: "module_allocation_organizationId_fkey")
  @@map("module_allocations")
}

model user_password_resets {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_password_resets_userId_fkey")
}